# Toss Open API
TOSS_CLIENT_ID=your_toss_client_id_here
TOSS_CLIENT_SECRET=your_toss_client_secret_here
TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_TOKEN_URL=https://openapi.tossinvest.com/oauth2/token

# Email report delivery
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
RECIPIENT_EMAIL=your@gmail.com

# Analysis settings
TRADING_BUDGET=1000000
MAX_POSITION_RATIO=0.50
MAX_SELECTED_STOCKS=5
SYMBOL_SCAN_LIMIT=400
LOG_LEVEL=INFO
LOG_FILE=logs/trading_system.log

# AI reliability analysis (DART/SEC filings + news + Ollama)
AI_RELIABILITY_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
DART_API_KEY=your_dart_api_key_here
SEC_USER_AGENT=AI_Trading_System your@email.com
AI_NEWS_LIMIT=5
AI_FILING_DAYS=30
AI_CACHE_TTL_HOURS=12
AI_FILING_EXCERPT_COUNT=2
OLLAMA_TIMEOUT_SECONDS=300